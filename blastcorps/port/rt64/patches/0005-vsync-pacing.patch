+    // (port patch 0005) Vsync pacing.
+    //
+    // RT64 hands the swap chain a picture every 1 / targetRate s on its own timer (preciseSleepUntil in
+    // threadPresent), and plume's D3D12 swap chain presents with a sync interval of 0 even with vsync
+    // on (present wait): the display shows whichever picture is newest at each refresh. A timer
+    // running at the display's own rate beats against the refreshes: when its phase sits near a
+    // refresh, some refreshes get two pictures (one never shown) and the next none.
+    //
+    // With vsync pacing every picture is presented with a sync interval of 1 (D3D12; Vulkan's FIFO
+    // swap chain is the same): it is shown from the refresh after the present, after the pictures
+    // queued before it, and never dropped. The frame-latency wait before each present keeps one
+    // picture queued. How many refreshes the picture before stays (holdFor):
+    //  - an in-between picture (a frame rate above the game's own) one refresh when the target rate
+    //    is the display's, N when it is 1/N of it;
+    //  - a game picture the display refreshes between its submission and the next one's (the game's
+    //    retraces: 2 in play, 1 or 2 in the front end; less the refreshes its in-between pictures
+    //    took). For a hold of N > 1 the present waits until the middle of the refresh before the
+    //    one it is to be shown at, counted from when the picture before was shown (waitForHold):
+    //    half a refresh of slack either way, so the hold doesn't depend on the phase of the game's
+    //    retraces against the display's. A picture that comes late is presented at once and only
+    //    shows a refresh later, which the next holds keep (one refresh more latency, no stutter).
+    //    The holds follow the submissions' timeline: a drift between the game's clock and the
+    //    display's (or a rate that isn't a whole number of refreshes) changes a hold by one only when
+    //    the timeline is 3/4 of a refresh off, not at every jitter of the submissions.
+    // When the present thread is behind (another present is waiting), nothing is held. When an
+    // in-between picture would reach the display more than two refreshes after its submission (the
+    // present thread fell behind and the queue keeps it there), it is dropped once (D3D12,
+    // dropToCatchUp): the picture before stays one refresh longer, and the latency is back to normal.
+    //
+    // 0 where this doesn't apply (vsync or the pacing off, an unknown display rate, in-between
+    // pictures at a rate that doesn't divide the display's): RT64's own pacing then, as before.
+    uint32_t PresentQueue::holdFor(const Present &present, bool firstOfPresent, uint32_t targetRate, bool interpolated) {
+        const uint32_t step = pacingStep(targetRate, interpolated);
+        if (step == 0) {
+            pacingPhase = 0.0;
+            return 0;
+        }
+
+        uint32_t hold = step;
+        if (firstOfPresent) {
+            const double sinceLast = std::chrono::duration<double>(present.submitTime - pacingLastSubmit).count();
+            if ((pacingLastFrames == 0) || (sinceLast <= 0.0) || (sinceLast > 0.25)) {
+                hold = 1;
+                pacingPhase = 0.0;
+            }
+            else {
+                const double ideal = sinceLast / refreshPeriod() - double(pacingLastFrames - 1) * double(pacingLastStep);
+                long rounded = std::max(1L, std::lround(ideal));
+                pacingPhase = std::clamp(pacingPhase + ideal - double(rounded), -2.0, 2.0);
+                if (pacingPhase > 0.75) {
+                    rounded++;
+                    pacingPhase -= 1.0;
+                }
+                else if ((pacingPhase < -0.75) && (rounded > 1)) {
+                    rounded--;
+                    pacingPhase += 1.0;
+                }
+
+                hold = uint32_t(std::min(rounded, 15L));
+            }
+        }
+
+        pacingLastStep = step;
+
+        {
+            const std::scoped_lock lock(cursorMutex);
+            if (writeCursor != threadCursor) {
+                hold = 1;
             }
         }
+
+        return hold;
+    }
+
+    // Refreshes per picture when vsync pacing applies (1 for game pictures; display rate / target
+    // rate for in-between pictures), 0 when it doesn't.
+    uint32_t PresentQueue::pacingStep(uint32_t targetRate, bool interpolated) const {
+        const uint32_t displayRate = ext.appWindow->getRefreshRate();
+        if (!vsyncPacing || !ext.swapChain->isVsyncEnabled() || (displayRate == 0) || (Timer::current() < pacingFallbackUntil)) {
+            return 0;
+        }
+
+        if (!interpolated) {
+            return 1;
+        }
+
+        if ((targetRate == 0) || (targetRate > displayRate) || ((displayRate % targetRate) != 0)) {
+            return 0;
+        }
+
+        return displayRate / targetRate;
+    }
+
+    double PresentQueue::refreshPeriod() const {
+        return (pacingPeriod > 0.0) ? pacingPeriod : (1.0 / double(std::max(ext.appWindow->getRefreshRate(), 1U)));
+    }
+
+    // D3D12: DXGI's frame statistics. shownAgo: seconds since the picture on screen was first shown;
+    // queued: pictures presented but not shown yet. Also measures the refresh period (pacingPeriod).
+    bool PresentQueue::pacingStats(double &shownAgo, uint32_t &queued) {
+#   if defined(_WIN32)
+        if (ext.createdGraphicsAPI != UserConfiguration::GraphicsAPI::D3D12) {
+            return false;
+        }
+
+        IDXGISwapChain3 *dxgi = static_cast<plume::D3D12SwapChain *>(ext.swapChain)->d3d;
+        DXGI_FRAME_STATISTICS stats = {};
+        UINT lastCount = 0;
+        LARGE_INTEGER qpcNow, qpcFreq;
+        QueryPerformanceCounter(&qpcNow);
+        QueryPerformanceFrequency(&qpcFreq);
+        if (FAILED(dxgi->GetFrameStatistics(&stats)) || FAILED(dxgi->GetLastPresentCount(&lastCount)) || (stats.PresentCount > lastCount)) {
+            return false;
+        }
+
+        // The refresh period from statistics a second or more apart.
+        const double nominal = 1.0 / double(std::max(ext.appWindow->getRefreshRate(), 1U));
+        if ((pacingStatsRefresh != 0) && (stats.SyncRefreshCount > pacingStatsRefresh + 60)) {
+            const double measured = double(stats.SyncQPCTime.QuadPart - pacingStatsQpc) / double(qpcFreq.QuadPart) / double(stats.SyncRefreshCount - pacingStatsRefresh);
+            pacingPeriod = (std::fabs(measured - nominal) < nominal * 0.05) ? measured : 0.0;
+            pacingStatsRefresh = 0;
+        }
+
+        if (pacingStatsRefresh == 0) {
+            pacingStatsRefresh = stats.SyncRefreshCount;
+            pacingStatsQpc = stats.SyncQPCTime.QuadPart;
+        }
+
+        const double syncAgo = double(qpcNow.QuadPart - stats.SyncQPCTime.QuadPart) / double(qpcFreq.QuadPart);
+        shownAgo = syncAgo + double(stats.SyncRefreshCount - stats.PresentRefreshCount) * refreshPeriod();
+        queued = lastCount - stats.PresentCount;
+        return true;
+#   else
+        return false;
+#   endif
+    }
+
+    // Until the middle of the (hold - 1)th refresh after the one the picture before was first shown
+    // at (D3D12: frame statistics; otherwise: when the frame-latency wait returned, if it waited).
+    void PresentQueue::waitForHold(uint32_t hold, Timestamp waitStart) {
+        const Timestamp now = Timer::current();
+        double shownAgo = 0.0;
+        uint32_t queued = 0;
+        if (pacingStats(shownAgo, queued)) {
+            // The statistics can still be those of the refresh before (just after the wait): a picture
+            // still queued shows a refresh after the one on screen.
+            shownAgo -= double(queued) * refreshPeriod();
+        }
+        else {
+            if (std::chrono::duration<double>(now - waitStart).count() <= 0.001) {
+                return;
+            }
+
+            shownAgo = 0.0;
+        }
+
+        // A wait of more than a refresh (and a quarter: the most it is when the latency is as low as it
+        // can be is half a refresh) is latency kept from an earlier delay: shorten it by whole refreshes
+        // (the picture before stays that much shorter, once).
+        const double period = refreshPeriod();
+        double untilDue = (double(hold) - 0.5) * period - shownAgo;
+        if (untilDue > 1.25 * period) {
+            // (Only when it lasted for 30 pictures: not in a burst of late submissions.)
+            if (++pacingExcess >= 30) {
+                untilDue -= std::floor((untilDue - 0.25 * period) / period) * period;
+                pacingTrims++;
+                pacingExcess = 0;
+            }
+        }
+        else {
+            pacingExcess = 0;
+        }
+
+        if ((untilDue > 0.0) && (untilDue < 0.25)) {
+            Timer::preciseSleepUntil(now + std::chrono::nanoseconds(int64_t(untilDue * 1e9)));
+        }
+    }
+
+    // An in-between picture that would wait behind a queued one and reach the display more than two
+    // refreshes after its submission: dropped (D3D12, vsync pacing at one refresh per picture).
+    bool PresentQueue::dropToCatchUp(const Present &present, int32_t frameIndex, int32_t framesToPresent, uint32_t targetRate, bool interpolated) {
+        if ((frameIndex + 1 >= framesToPresent) || (pacingStep(targetRate, interpolated) != 1)) {
+            return false;
+        }
+
+        double shownAgo = 0.0;
+        uint32_t queued = 0;
+        if (!pacingStats(shownAgo, queued) || (queued == 0)) {
+            return false;
+        }
+
+        // (Nothing queued: presented now, it shows as soon as it can.) The refresh this picture would be shown at if presented now (+1 ms to draw it).
+        const double period = refreshPeriod();
+        double showIn = double(queued + 1) * period - shownAgo;
+        if (showIn < 0.001) {
+            showIn = std::ceil((0.001 + shownAgo) / period) * period - shownAgo;
+        }
+
+        const double submittedAgo = std::chrono::duration<double>(Timer::current() - present.submitTime).count();
+        if (submittedAgo + showIn > 2.0 * period + 0.002) {
+            pacingDrops++;
+            noteStruggle();
+            return true;
+        }
+
+        return false;
+    }
+
+    // When the present thread can't keep up with the display (a busy GPU or CPU: six pictures dropped or
+    // presented over four refreshes late within two seconds), vsync pacing only makes it worse (every
+    // picture waits for its own refresh): RT64's own pacing for the next ten seconds.
+    void PresentQueue::noteStruggle() {
+        const Timestamp now = Timer::current();
+        pacingStruggles[pacingStruggleIndex] = now;
+        pacingStruggleIndex = (pacingStruggleIndex + 1) % pacingStruggles.size();
+        const Timestamp oldest = pacingStruggles[pacingStruggleIndex];
+        if ((oldest != Timestamp()) && (now - oldest < std::chrono::seconds(2))) {
+            pacingFallbackUntil = now + std::chrono::seconds(10);
+            pacingFallbacks++;
+            pacingStruggles.fill(Timestamp());
+        }
+    }
+
+    bool PresentQueue::swapChainPresent(bool vsyncPaced, uint32_t swapChainIndex, RenderCommandSemaphore **waitSemaphores) {
+#   if defined(_WIN32)
+        if (vsyncPaced && (ext.createdGraphicsAPI == UserConfiguration::GraphicsAPI::D3D12)) {
+            // plume's D3D12SwapChain::present with a sync interval of 1 (vsync is on: no tearing).
+            plume::D3D12SwapChain *d3d12SwapChain = static_cast<plume::D3D12SwapChain *>(ext.swapChain);
+            return SUCCEEDED(d3d12SwapChain->d3d->Present(1, 0));
+        }
+#   endif
+        return ext.swapChain->present(swapChainIndex, waitSemaphores, 1);
     }
 
